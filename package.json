{
  "name": "@algorandfoundation/xhd-wallet-api",
  "version": "2.0.0-canary.1",
  "description": "A Typescript implementation of Algorand ARC-52 extended hierarchical determinstic wallets.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
    "test": "pnpm clean && tsc -p tsconfig.spec.json && tsc-alias -p tsconfig.spec.json -f && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:cov": "pnpm clean && tsc -p tsconfig.spec.json && tsc-alias -p tsconfig.spec.json -f && node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "prepack": "pnpm build"
  },
  "keywords": [],
  "author": "Algorand Foundation",
  "license": "Apache-2.0",
  "devDependencies": {
    "@noble/ciphers": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "algo-msgpack-with-bigint": "^2.1.1",
    "bip32-ed25519": "^0.0.6",
    "hi-base32": "^0.6.0",
    "jest": "^30.5.2",
    "js-sha512": "^0.9.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tweetnacl": "^1.0.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "repository": "git@github.com:algorandfoundation/xHD-Wallet-API-ts.git",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): xHD Wallet API \n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": false
        }
      ]
    ],
    "branches": [
      "release/*",
      {
        "name": "main",
        "prerelease": "canary"
      }
    ]
  }
}
